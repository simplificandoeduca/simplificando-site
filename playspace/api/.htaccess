# Play Space 1.49: os registros de erro do PHP e qualquer .log desta pasta não abrem pelo navegador
<FilesMatch "(^error_log$|\.log$|\.novo$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
